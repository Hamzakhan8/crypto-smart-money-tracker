{
  "name": "market-flow-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning next-server.ts",
    "build": "next build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning next-server.ts --prod",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.engine.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "backtest": "node --experimental-strip-types --disable-warning=ExperimentalWarning screener-backtest.ts",
    "bigmove-backtest": "node --experimental-strip-types --disable-warning=ExperimentalWarning bigmove-backtest.ts",
    "alpha-backtest": "node --experimental-strip-types --disable-warning=ExperimentalWarning alpha-backtest.ts",
    "perps-backtest": "node --experimental-strip-types --disable-warning=ExperimentalWarning perps-backtest.ts",
    "pump-backtest": "node --experimental-strip-types --disable-warning=ExperimentalWarning pump-backtest.ts",
    "rotation-backtest": "node --experimental-strip-types --disable-warning=ExperimentalWarning rotation-backtest.ts",
    "scalp-backtest": "node --experimental-strip-types --disable-warning=ExperimentalWarning scalp-backtest.ts",
    "spot-backtest": "node --experimental-strip-types --disable-warning=ExperimentalWarning spot-backtest.ts",
    "onchain-backtest": "node --experimental-strip-types --disable-warning=ExperimentalWarning onchain-backtest.ts",
    "live-report": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/live-report.ts",
    "build-labels": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-labels.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
