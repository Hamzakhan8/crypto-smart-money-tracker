{
  "//": "The engine (server.ts, the scanners, backtests, tests and scripts), run by Node's own TypeScript support. The pages in src/ use tsconfig.json.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "src", ".next", "next-env.d.ts"]
}
